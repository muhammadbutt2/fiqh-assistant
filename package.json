{
  "name": "fiqh-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI Islamic Fiqh Assistant for the Hanafi, Maliki, Shafi'i, and Hanbali schools.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "inventory:books": "tsx scripts/inventory-books.ts",
    "ocr:doctor": "tsx scripts/ocr-doctor.ts",
    "ingest:pilot": "tsx scripts/ingest-local-books.ts --mode pilot",
    "ingest:full": "tsx scripts/ingest-local-books.ts --mode full",
    "ocr:calibrate": "tsx scripts/ocr-calibrate.ts",
    "ocr:index": "tsx scripts/ocr-index.ts",
    "ingest:open-text": "tsx scripts/ingest-open-text.ts",
    "eval:real-book": "tsx scripts/eval-real-book.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@prisma/client": "^6.17.1",
    "jszip": "^3.10.1",
    "next": "^15.5.6",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unpdf": "^1.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.6",
    "happy-dom": "^18.0.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
