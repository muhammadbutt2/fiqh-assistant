# Copy to .env. Do not put real secrets in this file.

# PostgreSQL. Local Docker Compose default is only for a private machine.
DATABASE_URL="postgresql://fiqh:fiqh-local-only@localhost:5432/fiqh?schema=public"

# HMAC secret for session cookies. Required before admin or account login works.
AUTH_SECRET=""

# Plain setup password for the admin role. Leave empty to keep admin routes closed.
ADMIN_PASSWORD=""

# AI provider. Leave the key empty. The app will not invent answers.
# Used for (1) translating the question into Arabic and Urdu search queries, (2) answer generation.
# Without it: queries come from the terminology registry only, and no ruling text is generated.
# Any OpenAI-compatible endpoint works (local server, free tier, or paid). Nothing here is free by default;
# check the terms of whatever AI_BASE_URL points at. Grok's consumer website is not an API and is not used.
AI_PROVIDER="openai-compatible"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_CHAT_MODEL=""
AI_EMBEDDING_MODEL=""
AI_TRANSLATION_MODEL=""

# Optional separate translation endpoint. Uses AI_API_KEY if these are empty.
TRANSLATION_BASE_URL=""
TRANSLATION_API_KEY=""

# Storage stays outside git. Point this at a folder you own.
STORAGE_DIR=".data/storage"
STORE_PATH=".data/store.json"

# Optional folder of local books. Files are inventoried, not copied into git.
BOOKS_DIR=""

# Upload and abuse limits.
MAX_UPLOAD_BYTES="83886080"
ASK_RATE_LIMIT_PER_HOUR="30"
MAX_QUESTION_CHARS="4000"

# Default answer language when the user has not chosen one and the question language is not en/ur/ar.
# This version supports exactly three: en, ur, ar.
DEFAULT_ANSWER_LOCALE="en"

# OCR. Leave empty if Tesseract is not installed. The job then fails honestly.
# TESSERACT_CMD: full path to tesseract.exe. Empty means PATH, then the standard Windows install folders.
TESSERACT_CMD=""
# TESSDATA_PREFIX: folder holding ara/urd/eng/osd .traineddata. Empty means .data/tessdata, then the engine default.
TESSDATA_PREFIX=""
# Fallback only. Each book has its own language (ara for Hidayah/Quduri/Hindiyyah, urd+ara for Bahishti Zewar).
OCR_LANGUAGES="ara+urd"
OCR_DATA_DIR=".data/ocr"
OCR_RENDER_DPI="300"
OCR_MAX_RENDER_PIXELS="12000000"
OCR_PSM="3"
OCR_DETECT_ROTATION="false"
OCR_TIMEOUT_MS="180000"
OCR_CONCURRENCY="2"
OCR_THREADS_PER_JOB=""
OCR_BATCH_SIZE="20"
OCR_PILOT_MAX_PAGES="40"

# Quality gate. These are the defaults. Loosening past the ceilings is refused unless
# OCR_ALLOW_LOOSE_THRESHOLDS="true", and every report then says the thresholds were loosened.
OCR_MAX_CER="0.05"
OCR_MAX_WER="0.15"
OCR_MAX_CRITICAL_ERROR_RATE="0.03"
OCR_MAX_PAGE_CER="0.15"
OCR_MIN_CALIBRATION_PAGES="10"
OCR_MIN_REFERENCE_CHARS="150"
OCR_MIN_PAGE_CONFIDENCE="60"
OCR_POOR_CONFIDENCE="75"
OCR_GATE_METRIC="strict"
OCR_ALLOW_LOOSE_THRESHOLDS="false"

# Set to "true" only for a private log review. Default keeps question text out of the audit log.
LOG_QUESTION_TEXT="false"
