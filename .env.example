# Copy to .env. Do not put real secrets in this file.

# PostgreSQL. Local Docker Compose default is only for a private machine.
DATABASE_URL="postgresql://fiqh:fiqh-local-only@localhost:5432/fiqh?schema=public"

# HMAC secret for session cookies. Required before admin or account login works.
AUTH_SECRET=""

# Plain setup password for the admin role. Leave empty to keep admin routes closed.
ADMIN_PASSWORD=""

# AI provider. Leave the key empty. The app will not invent answers.
AI_PROVIDER="openai-compatible"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_CHAT_MODEL=""
AI_EMBEDDING_MODEL=""
AI_TRANSLATION_MODEL=""

# Optional separate translation endpoint. Uses AI_API_KEY if these are empty.
TRANSLATION_BASE_URL=""
TRANSLATION_API_KEY=""

# Storage stays outside git. Point this at a folder you own.
STORAGE_DIR=".data/storage"
STORE_PATH=".data/store.json"

# Optional folder of local books. Files are inventoried, not copied into git.
BOOKS_DIR=""

# Upload and abuse limits.
MAX_UPLOAD_BYTES="83886080"
ASK_RATE_LIMIT_PER_HOUR="30"
MAX_QUESTION_CHARS="4000"

# Default answer locale. Must be one of the registry locales.
DEFAULT_ANSWER_LOCALE="en"

# OCR. Leave empty if Tesseract is not installed. The job then fails honestly.
TESSERACT_CMD=""
OCR_LANGUAGES="ara+urd"

# Set to "true" only for a private log review. Default keeps question text out of the audit log.
LOG_QUESTION_TEXT="false"
